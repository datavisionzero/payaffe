<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Payaffe.Sdk</PackageId>
    <Description>Typed .NET client for the Payaffe Integration API.</Description>
    <Authors>payaffe contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/datavisionzero/payaffe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
