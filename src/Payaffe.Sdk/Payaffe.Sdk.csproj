<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Payaffe.Sdk</PackageId>
    <Description>Typed .NET client for the Payaffe Integration API.</Description>
    <Authors>payaffe contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/datavisionzero/payaffe</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>payaffe;payments;cryptocurrency;bitcoin;litecoin;ethereum</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The SDK carries its own version and deliberately overrides the product
      version in Directory.Build.props. An installation upgrading from one
      payaffe release to the next does not oblige every integrator to take a
      new package, and a fix in the client must be shippable without claiming a
      server release that never happened. The two version lines meet only in
      the contract the baseline states: SDK 1.x speaks Integration API /api/v1.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!--
      The QR encoder. It is the SDK's only non-Microsoft dependency, it is MIT
      licensed, and it brings nothing with it: no imaging stack, no native
      component, and no transitive package a consumer would have to audit.
    -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
