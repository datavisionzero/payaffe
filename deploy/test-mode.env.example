# A Test Mode installation: for developing and testing an integration, never for
# taking payments (ADR 0033). Copy this file to `.env` beside compose.yaml in a
# directory of its own, fill in the two values, and start.
#
#   docker compose up -d
#
# It needs no wallet, no blockchain provider account and no exchange-rate key.
# Payment Addresses are simulated testnet addresses nobody holds a key for,
# exchange rates are fixed, and a payment arrives when someone simulates it: the
# Payer Page offers "I have paid", and an embedded integration calls the SDK's
# SimulatePaymentAsync. docs/operations/test-mode.md walks through it.
#
# The mode is written into the database the first time the installation starts,
# and a host configured for the other mode refuses to start against it. Give a
# test installation its own database volume; never point it at a live one.

PAYAFFE_INSTALLATION_MODE=test

# Any value; this database holds nothing worth protecting beyond the Admin
# Accounts you create in it.
PAYAFFE_DB_PASSWORD=

# Where the integration under test and your browser reach this installation.
PAYAFFE_PUBLIC_URL=http://localhost:8080

# A simulated payment is reported on the observation worker's next poll and
# confirmed on the one after, so a short interval keeps a test short. Webhook
# deliveries follow on the delivery worker's poll.
PAYAFFE_OBSERVATION_WORKER_POLL_INTERVAL=00:00:05
PAYAFFE_WEBHOOK_DELIVERY_POLL_INTERVAL=00:00:02

# The secret your integration's webhook receiver verifies with. Reference it
# from the Webhook Endpoint you create in the Admin UI as
# configuration:Webhooks:EndpointSecrets:partner-v1.
PAYAFFE_WEBHOOK_ENDPOINT_SECRET_PARTNER_V1=
