# Configuration for an installation running published images. Copy this file to
# `.env` beside compose.yaml, fill in the values below, and keep it out of any
# repository: it is where the secrets of the installation live (ADR 0021).
#
#   chmod 600 .env
#
# Everything not listed here has a default that suits an installation taking
# tens of payments a day. docs/operations/docker-compose.md is the full
# reference, including the settings that only matter once something is wrong.

# --- Required ---------------------------------------------------------------

# The product database password. Generate one and never reuse it:
#   openssl rand -base64 32
PAYAFFE_DB_PASSWORD=

# The public address of this installation, with no trailing slash. It is where
# a payer's browser is sent and the origin the API accepts browser calls from,
# and it is one value because the reverse proxy in front serves both hosts from
# it: /api/ and /health/ go to the API host, everything else to the web host.
PAYAFFE_PUBLIC_URL=https://pay.example.com

# --- Images -----------------------------------------------------------------

# The release this installation runs. Pin it to a version rather than leaving
# it at `latest`, so that `docker compose pull` upgrades when you decide to and
# not when a tag moves.
PAYAFFE_VERSION=latest

# The published web image carries no API address and works at any. Only an
# installation whose API answers at a *different* origin than its web app needs
# its own image, built with that address compiled in, and named here alongside
# PAYAFFE_WEB_PUBLIC_ORIGIN for CORS.
# PAYAFFE_WEB_IMAGE=payaffe-web:local
# PAYAFFE_WEB_PUBLIC_ORIGIN=https://pay.example.com

# --- Exposure ---------------------------------------------------------------

# Both ports are published on the loopback interface, for a reverse proxy in
# front to terminate TLS. Setting this to 0.0.0.0 exposes admin sign-in and the
# payer page directly, in the clear.
# PAYAFFE_BIND_ADDRESS=127.0.0.1
# PAYAFFE_API_PORT=8080
# PAYAFFE_WEB_PORT=3000

# --- Blockchain observation -------------------------------------------------

# `none`, `blockchair`, or `nownodes`. Nothing is observed until one is chosen,
# and the two are never mixed (ADR 0004). This provider decides whether a
# payment arrived, which is the trust this product makes explicit (ADR 0003).
PAYAFFE_BLOCKCHAIN_OBSERVATION_MODE=none

# The key is a reference in the settings and a value here, so it never reaches
# the database, an audit entry, or an observation record. Set the reference and
# the key of the provider that is selected above.
# PAYAFFE_BLOCKCHAIN_OBSERVATION_BLOCKCHAIR_API_KEY_REFERENCE=configuration:BlockchainObservation:ProviderSecrets:blockchair
# PAYAFFE_BLOCKCHAIR_API_KEY=
# PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_API_KEY_REFERENCE=configuration:BlockchainObservation:ProviderSecrets:nownodes
# PAYAFFE_NOWNODES_API_KEY=

# --- Receiving addresses ----------------------------------------------------

# Extended public keys only. An extended private key, a seed phrase, or a
# private key is rejected, and payaffe holds nothing that can spend (ADR 0005).
# PAYAFFE_BTC_WATCH_ONLY_ENABLED=true
# PAYAFFE_BTC_WATCH_ONLY_EXTENDED_PUBLIC_KEY=xpub...
# PAYAFFE_LTC_WATCH_ONLY_ENABLED=true
# PAYAFFE_LTC_WATCH_ONLY_EXTENDED_PUBLIC_KEY=Ltub...

# Native ETH has no watch-only derivation and uses an imported address pool
# instead (ADR 0006). Import it through the Admin UI, not through this file.

# --- Exchange rates ---------------------------------------------------------

# CoinGecko works without a key. A demo key needs both lines.
# PAYAFFE_EXCHANGE_RATES_API_KEY_REFERENCE=configuration:ExchangeRates:ProviderSecrets:coingecko
# PAYAFFE_COINGECKO_API_KEY=

# --- First admin ------------------------------------------------------------

# A Base32 TOTP secret, generated without writing it to shell history:
#   openssl rand 20 | base32 | tr -d '\n'
# The bootstrap command reads it through this slot, and admin sign-in resolves
# it at runtime afterwards, so it stays here (ADR 0020).
PAYAFFE_ADMIN_TOTP_SECRET_FIRST_ADMIN=

# --- Webhook endpoint secrets -----------------------------------------------

# The HMAC secrets a receiver verifies deliveries with. Two slots, so a secret
# can be rotated with an overlap; the endpoint record stores only the reference
# (docs/operations/credential-rotation.md).
PAYAFFE_WEBHOOK_ENDPOINT_SECRET_PARTNER_V1=
PAYAFFE_WEBHOOK_ENDPOINT_SECRET_PARTNER_V2=

# --- Browser errors ---------------------------------------------------------

# Errors the payer page and the Admin UI could not handle are posted back to
# this installation and logged with everything else, which is why no separate
# error-tracking service is needed for them.
#
# It is the one endpoint anybody on the internet may post to, so it is bounded:
# per-address rate limit, a hard size cap, and a fixed set of fields. Entries
# land at Warning rather than Error on purpose -- an unauthenticated caller must
# not be able to raise the number an alert is derived from.
#
# Set to false to leave the endpoint unmapped altogether.
# PAYAFFE_CLIENT_ERRORS_ENABLED=true
# PAYAFFE_CLIENT_ERROR_RATE_LIMIT_PERMIT_LIMIT=10
# PAYAFFE_CLIENT_ERROR_RATE_LIMIT_WINDOW=00:01:00

# --- Logs -------------------------------------------------------------------

# A logaffe installation is where these hosts deliver their log entries
# (ADR 0025). Set both or neither: half a configuration is refused at startup,
# because logs nobody noticed were missing are noticed too late. The address is
# scheme and host only -- the ingest path is not a setting.
#
# The token is a secret, and it is also what names the logaffe project the
# entries land in. Issue one per installation.
#
# Left empty, logs stay on stdout and `docker compose logs` is the whole story.
# PAYAFFE_LOGAFFE_URL=https://logs.example.com
# PAYAFFE_LOGAFFE_TOKEN=

# --- Telemetry --------------------------------------------------------------

# Traces and metrics, not logs. All optional and all off when empty.
# PAYAFFE_OTLP_ENDPOINT=http://otel-collector:4317
# PAYAFFE_BACKEND_GLITCHTIP_DSN=
# PAYAFFE_DEPLOYMENT_ENVIRONMENT=production
