PAYAFFE_DB_NAME=payaffe
PAYAFFE_DB_USER=payaffe
PAYAFFE_DB_PASSWORD=change-this-local-password
PAYAFFE_DB_PORT=5432
PAYAFFE_API_PORT=8080
PAYAFFE_WEB_PORT=3000
PAYAFFE_API_PUBLIC_URL=http://localhost:8080
PAYAFFE_WEB_PUBLIC_ORIGIN=http://localhost:3000
PAYAFFE_PAYER_PAGE_BASE_URL=http://localhost:3000/pay
PAYAFFE_BLOCKCHAIN_OBSERVATION_MODE=none
PAYAFFE_BLOCKCHAIN_OBSERVATION_BLOCKCHAIR_BASE_URL=https://api.blockchair.com
PAYAFFE_BLOCKCHAIN_OBSERVATION_BLOCKCHAIR_API_KEY_REFERENCE=
PAYAFFE_BLOCKCHAIN_OBSERVATION_BLOCKCHAIR_MAX_TRANSACTIONS_PER_ADDRESS_POLL=10
PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_BTC_BASE_URL=https://btcbook.nownodes.io
PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_LTC_BASE_URL=https://ltcbook.nownodes.io
PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_ETH_BASE_URL=https://eth-blockbook.nownodes.io
PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_API_KEY_REFERENCE=
PAYAFFE_BLOCKCHAIN_OBSERVATION_NOWNODES_MAX_TRANSACTIONS_PER_ADDRESS_POLL=10
PAYAFFE_LIFECYCLE_WORKER_ENABLED=true
PAYAFFE_LIFECYCLE_WORKER_POLL_INTERVAL=00:01:00
PAYAFFE_LIFECYCLE_WORKER_BATCH_SIZE=100
PAYAFFE_LIFECYCLE_WORKER_LEASE_DURATION=00:02:00
PAYAFFE_OBSERVATION_WORKER_ENABLED=true
PAYAFFE_OBSERVATION_WORKER_POLL_INTERVAL=00:01:00
PAYAFFE_OBSERVATION_WORKER_MAX_PAYMENTS_PER_POLL=25
PAYAFFE_OBSERVATION_WORKER_LEASE_DURATION=00:02:00
PAYAFFE_REORG_MONITORING_WORKER_ENABLED=true
PAYAFFE_REORG_MONITORING_WORKER_POLL_INTERVAL=00:05:00
PAYAFFE_REORG_MONITORING_WORKER_MAX_TRANSACTIONS_PER_POLL=25
PAYAFFE_REORG_MONITORING_WORKER_LEASE_DURATION=00:02:00
PAYAFFE_ADMIN_TOTP_SECRET_FIRST_ADMIN=
PAYAFFE_WEBHOOK_ENDPOINT_SECRET_PARTNER_V1=
PAYAFFE_WEBHOOK_ENDPOINT_SECRET_PARTNER_V2=
PAYAFFE_EXCHANGE_RATES_ENABLED=true
PAYAFFE_EXCHANGE_RATES_BASE_URL=https://api.coingecko.com
PAYAFFE_EXCHANGE_RATES_API_KEY_REFERENCE=
PAYAFFE_EXCHANGE_RATES_CACHE_INTERVAL=00:05:00
PAYAFFE_EXCHANGE_RATES_MAX_STALE_AGE=00:30:00
PAYAFFE_EXCHANGE_RATES_REQUEST_TIMEOUT=00:00:10
PAYAFFE_COINGECKO_API_KEY=
PAYAFFE_RATE_REFRESH_WORKER_ENABLED=true
PAYAFFE_RATE_REFRESH_WORKER_INTERVAL=00:05:00
PAYAFFE_RATE_REFRESH_WORKER_LEASE_DURATION=00:02:00
PAYAFFE_BTC_WATCH_ONLY_ENABLED=false
PAYAFFE_BTC_WATCH_ONLY_EXTENDED_PUBLIC_KEY=
PAYAFFE_BTC_WATCH_ONLY_NETWORK=mainnet
PAYAFFE_BTC_WATCH_ONLY_ADDRESS_TYPE=segwit
PAYAFFE_BTC_WATCH_ONLY_STARTING_INDEX=0
PAYAFFE_LTC_WATCH_ONLY_ENABLED=false
PAYAFFE_LTC_WATCH_ONLY_EXTENDED_PUBLIC_KEY=
PAYAFFE_LTC_WATCH_ONLY_NETWORK=mainnet
PAYAFFE_LTC_WATCH_ONLY_ADDRESS_TYPE=segwit
PAYAFFE_LTC_WATCH_ONLY_STARTING_INDEX=0
PAYAFFE_NATIVE_ETH_LOW_CAPACITY_THRESHOLD=20
PAYAFFE_ADMIN_AUTH_RATE_LIMIT_PERMIT_LIMIT=30
PAYAFFE_ADMIN_AUTH_RATE_LIMIT_WINDOW=00:05:00
PAYAFFE_INTEGRATION_API_RATE_LIMIT_PERMIT_LIMIT=120
PAYAFFE_INTEGRATION_API_RATE_LIMIT_WINDOW=00:01:00
PAYAFFE_WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
PAYAFFE_WEBHOOK_DELIVERY_ENABLED=true
PAYAFFE_WEBHOOK_DELIVERY_RETRY_DELAY=00:01:00
PAYAFFE_WEBHOOK_DELIVERY_RETRY_BACKOFF_MULTIPLIER=2
PAYAFFE_WEBHOOK_DELIVERY_MAX_RETRY_DELAY=00:30:00
PAYAFFE_WEBHOOK_DELIVERY_RETRY_JITTER_RATIO=0.2
PAYAFFE_WEBHOOK_DELIVERY_POLL_INTERVAL=00:00:10
PAYAFFE_WEBHOOK_DELIVERY_MAX_EVENTS_PER_POLL=25
PAYAFFE_WEBHOOK_DELIVERY_LEASE_DURATION=00:02:00
# Background work runs in the dedicated worker service. Set this to true only
# for a single-container installation without a worker service.
PAYAFFE_RUN_WORKERS_IN_API_HOST=false

# Worker container liveness. The max age has to stay longer than the probe
# interval, otherwise the heartbeat can never be fresh enough.
PAYAFFE_WORKER_HEALTH_PROBE_INTERVAL=00:00:15
PAYAFFE_WORKER_HEALTH_MAX_AGE=00:01:00

# Technical observability. Leave the OTLP endpoint empty to keep structured
# logs on stdout without exporting telemetry.
PAYAFFE_CLIENT_ERRORS_ENABLED=true
PAYAFFE_CLIENT_ERROR_RATE_LIMIT_PERMIT_LIMIT=10
PAYAFFE_CLIENT_ERROR_RATE_LIMIT_WINDOW=00:01:00
PAYAFFE_LOGAFFE_URL=
PAYAFFE_LOGAFFE_TOKEN=
PAYAFFE_OTLP_ENDPOINT=
PAYAFFE_OPERATIONAL_METRICS_SNAPSHOT_INTERVAL=00:00:30

PAYAFFE_DEPLOYMENT_ENVIRONMENT=production
PAYAFFE_RELEASE=

# Local Admin MCP host (stdio). Set to an existing Admin Account id.
PAYAFFE_MCP_ADMIN_ACCOUNT_ID=
PAYAFFE_MCP_PERMIT_LIMIT=60
PAYAFFE_MCP_WINDOW=00:01:00
