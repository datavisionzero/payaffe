    {
      "annotations": {
        "destructive": false,
        "idempotent": true,
        "openWorld": false,
        "readOnly": false
      },
      "description": "Risky action: imports public native ETH receiving addresses into the non-reusable Address Pool. Client confirmation is required.",
      "inputSchema": {
        "properties": {
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "addresses",
          "confirmed"
        ],
        "type": "object"
      },
      "name": "address_pool.import_native_eth",
      "outputSchema": {
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "importId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "importedCount": {
            "type": "integer"
          },
          "pool": {
            "properties": {
              "assignedCount": {
                "type": "integer"
              },
              "isLowCapacity": {
                "type": "boolean"
              },
              "lowCapacityThreshold": {
                "type": "integer"
              },
              "retiredCount": {
                "type": "integer"
              },
              "unusedCount": {
                "type": "integer"
              }
            },
            "required": [
              "assignedCount",
              "isLowCapacity",
              "lowCapacityThreshold",
              "retiredCount",
              "unusedCount"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "correlationId",
          "importId",
          "importedCount",
          "pool",
          "status",
          "summary"
        ],
        "type": "object"
      },
      "title": "Import Native ETH Addresses"
    },
