      },
      "name": "configuration.summarize",
      "outputSchema": {
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "lateAcceptanceWindow": {
            "$comment": "Represents a System.TimeSpan value.",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "observationMode": {
            "type": "string"
          },
          "paymentExpiration": {
            "$comment": "Represents a System.TimeSpan value.",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "paymentTolerancePercent": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "correlationId",
          "lateAcceptanceWindow",
          "observationMode",
          "paymentExpiration",
          "paymentTolerancePercent",
          "status",
          "summary"
        ],
        "type": "object"
      },
      "title": "Summarize Configuration"
    },
